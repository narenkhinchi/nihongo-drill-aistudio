    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,85 C70,82 130,82 150,85 L148,91 C130,88.5 70,88.5 52,91 Z" />
    <!-- Torii Gate Second Beam -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,98 L144,98 L144,103 L56,103 Z" />
    <!-- Torii Left Pillar -->
