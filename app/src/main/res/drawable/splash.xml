    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <!-- Gradient background disc -->
    <path android:pathData="M100,100m-90,0a90,90 0 1,1 180,0a90,90 0 1,1 -180,0">
