                android:startY="20"
                android:endX="180"
                android:endY="180"
                android:type="linear">
                <item android:color="#1E3A8A" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Inner glowing circle -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M100,85m-30,0a30,30 0 1,1 60,0a30,30 0 1,1 -60,0" />
